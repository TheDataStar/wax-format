# Step 6b: the box API and pack server (deltd), as its own unprivileged user
# (privilege boundary §3). It starts on every box, hotspot or not, on the
# WebOS hostname home.deltos.lan (contract §8), once the box has people to
# serve: its identity source is deltos-identityd's socket, and both wait for
# the first admin (docs/identityd.md §6). There is no anonymous mode.
#
# HTTPS (port 443) runs with the box's two certificates from
# /var/lib/deltos/tls/ (contract §8), made just before by deltos-tls.service
# (docs/box-certificates.md). Without them deltd serves plain HTTP only, and
# says that teachers and admins cannot sign in.
[Unit]
Description=DeltOS box API and pack server (deltd)
Documentation=https://github.com/TheDataStar/wax-format/blob/main/docs/box-radio-and-boot.md
ConditionPathExists=/var/lib/deltos/identity/identity.sqlite
Wants=deltos-net-render.service deltos-identityd.service deltos-tls.service
After=deltos-net-render.service deltos-dnsmasq.service deltos-identityd.service deltos-tls.service
StartLimitIntervalSec=10min
StartLimitBurst=10

[Service]
Type=simple
User=deltos-deltd
Group=deltos-deltd
Environment=DELTOS_WEBOS_HOST=home.deltos.lan DELTD_CONNECTIVITY_ARGS=
Environment="DELTD_IDENTITY_ARGS=--identity-socket /run/deltos/identity/identityd.sock"
Environment="DELTD_TLS_ARGS=--tls-listen 0.0.0.0:443 --tls-cert-dir /var/lib/deltos/tls"
EnvironmentFile=-/run/deltos/network/deltd.env
ExecCondition=/usr/lib/deltos/libexec/deltos-deltd-ready
ExecStart=/usr/lib/deltos/bin/deltd --webos-host ${DELTOS_WEBOS_HOST} --packs /var/lib/deltos/packs --catalog-dir /var/lib/deltos/b4 $DELTD_IDENTITY_ARGS $DELTD_TLS_ARGS $DELTD_CONNECTIVITY_ARGS
Restart=on-failure
RestartSec=2s
RestartSteps=5
RestartMaxDelaySec=60s
StateDirectory=deltos/b4
StateDirectoryMode=0750
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/deltos/packs
InaccessiblePaths=-/var/lib/deltos/network -/run/deltos/network -/var/lib/deltos/identity -/var/lib/deltos/ca
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
