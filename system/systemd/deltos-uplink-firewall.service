# Step 3: the uplink firewall, loaded before the hotspot exists, so no
# hotspot device is ever forwarded anywhere it should not be.
[Unit]
Description=DeltOS uplink firewall (internet sharing for hotspot devices)
ConditionPathExists=/run/deltos/network/uplink.nft
Documentation=https://github.com/TheDataStar/wax-format/blob/main/docs/box-radio-and-boot.md
Requires=deltos-net-render.service
# Early boot (before network-pre.target), so no default dependencies: with
# them it would also be ordered after basic.target, which on systems whose
# network starts in early boot (systemd-networkd with cloud-init, for one)
# is an ordering cycle that systemd breaks by dropping a unit.
DefaultDependencies=no
Conflicts=shutdown.target
After=local-fs.target deltos-net-render.service
Before=deltos-hostapd.service network-pre.target shutdown.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/run/deltos/network/hotspot.env
ExecStart=/usr/lib/deltos/libexec/deltos-uplink-firewall start
ExecStop=/usr/lib/deltos/libexec/deltos-uplink-firewall stop
