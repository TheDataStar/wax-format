#!/bin/sh
# deltd starts only with a WebOS hostname under deltos.lan (home.deltos.lan
# unless overridden) and an identity source
# (system/systemd/deltos-deltd.service). Exit 1 skips it with this message;
# nothing is guessed.
case "${DELTOS_WEBOS_HOST:-}" in
*?.deltos.lan) ;;
*)
    echo "deltd not started: DELTOS_WEBOS_HOST is not set to a name under deltos.lan (contract §8: home.deltos.lan)" >&2
    exit 1
    ;;
esac
if [ -z "${DELTD_IDENTITY_ARGS:-}" ]; then
    echo "deltd not started: no identity source in DELTD_IDENTITY_ARGS (the unit's default is deltos-identityd's socket)" >&2
    exit 1
fi
