    },
    "/api/v1/suggest": {
      "get": {
        "summary": "Title completion across packs: exact under each pack's declared fold first, then accent-insensitive",
        "x-permission": "Signed in",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Typed prefix",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "packs",
            "in": "query",
            "required": false,
            "description": "Comma-separated archive_uuids",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "BCP-47",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "1–100, default 20",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
