    "/api/v1/search": {
      "get": {
        "summary": "One query across every pack the person may see, fused by position (RRF). Packs that cannot answer are listed in skipped.",
        "x-permission": "Signed in",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Words; matched accent-insensitively",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "packs",
            "in": "query",
            "required": false,
            "description": "Comma-separated archive_uuids",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "BCP-47",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Contract §11 category",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "1–100, default 20",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque value from a previous response's next",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "description": "Not modified (ETag)"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
