    "/api/v1/openapi.json": {
      "get": {
        "summary": "This document",
        "x-permission": "None",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Problem": {
        "description": "RFC 9457 problem, code from deltd API §7",
        "content": {
          "application/problem+json": {
            "schema": {
              "type": "object",
              "required": [
                "status",
                "code",
                "title"
              ],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string",
                  "enum": [
                    "invalid_request",
                    "not_signed_in",
                    "permission_denied",
                    "guest_not_allowed",
                    "request_rejected",
                    "secure_connection_required",
                    "confirmation_required",
                    "pack_not_found",
                    "page_not_found",
                    "page_removed",
                    "edition_mismatch",
                    "search_unavailable",
                    "signature_invalid",
                    "not_enough_resources",
                    "not_enough_storage",
                    "too_many_requests",
                    "pack_damaged",
                    "internal"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
